{
  "name": "song-recommender-memory",
  "version": "1.0.0",
  "description": "Song recommender with LangGraph memory persistence using LibSQL",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f postgres",
    "chat:erickwendel": "node --experimental-strip-types --env-file .env src/index.ts --user erickwendel",
    "chat:ana": "node --experimental-strip-types --env-file .env src/index.ts --user ana",
    "test": "node --experimental-strip-types --env-file .env --test tests/**/*.test.ts",
    "test:watch": "node --experimental-strip-types --env-file .env --test --watch tests/**/*.test.ts",
    "langgraph:serve": "langgraphjs dev"
  },
  "keywords": [
    "langchain",
    "langgraph",
    "memory",
    "libsql",
    "sqlite",
    "song-recommender",
    "openrouter"
  ],
  "author": "erickwendel",
  "license": "MIT",
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.5.2",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "dependencies": {
    "@huggingface/inference": "^4.13.30",
    "@huggingface/transformers": "^4.3.0",
    "@langchain/core": "^1.2.16",
    "@langchain/langgraph": "^1.4.19",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.4",
    "@langchain/openai": "^1.6.2",
    "@libsql/client": "^0.18.0",
    "@openrouter/sdk": "^1.4.22",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^13.0.3",
    "knex": "^3.3.0",
    "langchain": "^1.5.15",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "sharp@0.32.6": true,
    "sharp@0.34.5": true,
    "protobufjs@6.11.4": true,
    "better-sqlite3@12.11.1": true,
    "@openrouter/sdk@1.4.22": true,
    "esbuild@0.28.2": true,
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true,
    "better-sqlite3@13.0.3": true,
    "fsevents@2.3.3": true
  }
}
